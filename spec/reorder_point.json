{
  "openapi": "3.0.3",
  "info": {
    "title": "LOGILESS API - 倉庫別発注点",
    "version": "2026.06.04",
    "description": "非公式。LOGILESS API の倉庫別発注点系。最終確認日: 2026-06-04。公式: https://app2.logiless.com/developer/"
  },
  "servers": [
    {
      "url": "https://app2.logiless.com/api/v1/merchant/{merchant_id}",
      "variables": {
        "merchant_id": {
          "default": "your-merchant-id",
          "description": "マーチャントID"
        }
      }
    }
  ],
  "security": [
    {
      "OAuth2": []
    }
  ],
  "paths": {
    "/reorder_points": {
      "get": {
        "summary": "倉庫別発注点の一覧を取得",
        "operationId": "listReorderPoints",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "取得する結果の数 - デフォルトは 20 最大値は 100",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "ページ - デフォルトは 1",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "article_code",
            "in": "query",
            "description": "商品コード",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "warehouse_id",
            "in": "query",
            "description": "倉庫ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "is_reorder_level",
            "in": "query",
            "description": "発注点割れかどうか",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReorderPointListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://app2.logiless.com/oauth/v2/auth",
            "tokenUrl": "https://app2.logiless.com/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "InterWarehouseTransfer": {
        "type": "object",
        "description": "倉庫間移動",
        "properties": {
          "waiting_for_shipment": {
            "type": "integer",
            "description": "未出荷の倉庫間移動数量"
          }
        }
      },
      "InventorySummaryByWarehouse": {
        "type": "object",
        "description": "倉庫別在庫数 - この在庫数はリアルタイムではなく、10分程度の遅延があります。",
        "properties": {
          "in_transit": {
            "type": "integer",
            "description": "入荷待ち"
          },
          "transferring": {
            "type": "integer",
            "description": "輸送中"
          },
          "received": {
            "type": "integer",
            "description": "入庫待ち"
          },
          "available": {
            "type": "integer",
            "description": "保管中"
          },
          "allocated": {
            "type": "integer",
            "description": "引当済み"
          },
          "inter_warehouse_transfer": {
            "$ref": "#/components/schemas/InterWarehouseTransfer"
          }
        }
      },
      "Article": {
        "type": "object",
        "description": "商品マスタ",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "object_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "article_type": {
            "type": "string"
          },
          "tax_indicator": {
            "type": "string"
          },
          "temperature_control": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "limiting_sales": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "Warehouse": {
        "type": "object",
        "description": "倉庫",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ReorderPoint": {
        "type": "object",
        "description": "倉庫別発注点",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID発注点情報をユニークに識別するための数値です。主に、APIでのアクセスに使用します。"
          },
          "reorder_point": {
            "type": "integer",
            "description": "発注点"
          },
          "inventory_constant": {
            "type": "integer",
            "description": "在庫定数"
          },
          "inventory_summary_by_warehouse": {
            "$ref": "#/components/schemas/InventorySummaryByWarehouse"
          },
          "created_at": {
            "type": "string",
            "description": "作成日時 - Y-m-d H:i:s形式 (例 : 2018-01-01 23:59:59)"
          },
          "updated_at": {
            "type": "string",
            "description": "更新日時 - Y-m-d H:i:s形式 (例 : 2018-01-01 23:59:59)"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          },
          "warehouse": {
            "$ref": "#/components/schemas/Warehouse"
          }
        }
      },
      "ReorderPointListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReorderPoint"
            }
          },
          "current_page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          }
        }
      }
    }
  }
}
