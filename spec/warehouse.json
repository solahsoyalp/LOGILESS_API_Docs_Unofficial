{
  "openapi": "3.0.3",
  "info": {
    "title": "LOGILESS API - 倉庫",
    "version": "2026.06.04",
    "description": "非公式。LOGILESS API の倉庫系。最終確認日: 2026-06-04。公式: https://app2.logiless.com/developer/"
  },
  "servers": [
    {
      "url": "https://app2.logiless.com/api/v1/merchant/{merchant_id}",
      "variables": {
        "merchant_id": {
          "default": "your-merchant-id",
          "description": "マーチャントID"
        }
      }
    }
  ],
  "security": [
    {
      "OAuth2": []
    }
  ],
  "paths": {
    "/warehouses": {
      "get": {
        "summary": "倉庫の一覧を取得",
        "operationId": "listWarehouses",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "取得する結果の数 - デフォルトは 20 最大値は 100",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "ページ - デフォルトは 1",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "倉庫の一覧",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://app2.logiless.com/oauth/v2/auth",
            "tokenUrl": "https://app2.logiless.com/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Warehouse": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true,
            "description": "ID。倉庫をユニークに識別するための数値です。主に、APIでのアクセスに使用します。"
          },
          "name": {
            "type": "string",
            "description": "店舗名"
          }
        }
      },
      "WarehouseList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warehouse"
            }
          },
          "current_page": {
            "type": "integer",
            "description": "現在のページ"
          },
          "limit": {
            "type": "integer",
            "description": "取得する結果の数"
          },
          "total_count": {
            "type": "integer",
            "description": "総件数"
          }
        }
      }
    }
  }
}
